erDiagram
    languages ||--o{ courses : "from_lang"
    languages ||--o{ courses : "learning_lang"
    courses ||--o{ units : contains
    units ||--o{ lessons : contains
    learners |o--o{ learners : "referred_by (optional)"
    learners ||--o{ enrollments : enrolls
    courses ||--o{ enrollments : has
    learners ||--o{ lesson_attempts : makes
    lessons ||--o{ lesson_attempts : receives
    learners ||--o{ daily_activity : records
    learners ||--o{ league_memberships : competes
    learners ||--o{ learner_achievements : earns
    achievements ||--o{ learner_achievements : awarded
    languages {
        varchar(2) language_code PK
        text language_name UK
    }
    courses {
        integer course_id PK
        varchar(2) from_lang FK
        varchar(2) learning_lang FK
        text title
        date launched_on
    }
    units {
        integer unit_id PK
        integer course_id FK
        smallint unit_no
        text title
        varchar(2) cefr_level
    }
    lessons {
        integer lesson_id PK
        integer unit_id FK
        smallint lesson_no
        text lesson_type
        smallint xp_value
    }
    learners {
        integer learner_id PK
        varchar(64) username UK
        text email UK
        varchar(2) country_code
        smallint daily_goal_xp
        text subscription
        integer referred_by FK
        timestamptz joined_at
    }
    enrollments {
        integer learner_id PK, FK
        integer course_id PK, FK
        timestamptz enrolled_at
        integer total_xp
        boolean is_active
    }
    lesson_attempts {
        bigint attempt_id PK
        integer learner_id FK
        integer lesson_id FK
        timestamptz started_at
        timestamptz completed_at
        smallint mistakes
        smallint hearts_lost
        smallint xp_earned
        boolean is_perfect
        text device
    }
    daily_activity {
        integer learner_id PK, FK
        date activity_date PK
        integer xp
        integer lessons_completed
        boolean used_streak_freeze
    }
    league_memberships {
        integer learner_id PK, FK
        date week_start PK
        text tier
        integer cohort_id
        integer weekly_xp
        smallint final_rank
        text result
    }
    achievements {
        integer achievement_id PK
        text code UK
        text name
    }
    learner_achievements {
        integer learner_id PK, FK
        integer achievement_id PK, FK
        timestamptz earned_at
    }
